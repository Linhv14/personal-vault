{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vitest/globals", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/ui/**/*.ts",
    "src/i18n/**/*.ts",
    "test/**/*.ts",
    "extension/**/*.ts",
    "extension/**/*.tsx",
    "share/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "cli/**/*.ts",
    "action/**/*.ts"
  ]
}
