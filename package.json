{
  "name": "personal-vault",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.scripts.json",
    "build": "node scripts/build.ts",
    "build:dev": "node scripts/build.ts --dev",
    "deploy": "node scripts/vault.ts deploy",
    "deploy:ci": "node scripts/vault.ts ci",
    "dev": "node scripts/vault.ts dev",
    "status": "node scripts/vault.ts status",
    "logs": "node scripts/vault.ts logs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node scripts/vault.ts backup",
    "package": "node scripts/package.ts",
    "publish:action": "node scripts/publish-action.ts",
    "publish:cli": "node scripts/publish-cli.ts"
  },
  "dependencies": {
    "@preact/signals": "2.5.0",
    "hono": "^4.6.14",
    "preact": "10.28.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@simplewebauthn/server": "14.0.3",
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "openpgp": "6.3.2",
    "prettier": "^3.9.10",
    "smol-toml": "1.9.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
