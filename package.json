{
  "name": "personal-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "deploy": "node scripts/vault.mjs deploy",
    "dev": "node scripts/vault.mjs dev",
    "status": "node scripts/vault.mjs status",
    "logs": "node scripts/vault.mjs logs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "esbuild": "^0.24.2",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.149.0"
  }
}
