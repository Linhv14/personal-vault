{
  "name": "personal-vault",
  "version": "0.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "lint": "eslint . --max-warnings 0 && node scripts/check-comments.ts",
    "knip": "knip --include files,exports,dependencies,devDependencies,unlisted",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p e2e-browser/tsconfig.json",
    "build": "node scripts/build.ts",
    "build:dev": "node scripts/build.ts --dev",
    "deploy": "node scripts/vault.ts deploy",
    "deploy:ci": "node scripts/vault.ts ci",
    "dev": "node scripts/vault.ts dev",
    "status": "node scripts/vault.ts status",
    "logs": "node scripts/vault.ts logs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node scripts/vault.ts backup",
    "package": "node scripts/package.ts",
    "publish:action": "node scripts/publish-action.ts",
    "publish:cli": "node scripts/publish-cli.ts"
  },
  "dependencies": {
    "@preact/signals": "2.5.0",
    "gsap": "3.14.2",
    "hono": "^4.6.14",
    "preact": "10.28.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/server": "14.0.3",
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^14.0.0",
    "happy-dom": "^20.14.6",
    "knip": "6.42.1",
    "openpgp": "6.3.2",
    "prettier": "^3.9.10",
    "smol-toml": "1.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
