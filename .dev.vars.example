# Template for local development secrets (`npm run dev` writes this file for
# you if it is missing). `cf deploy` generates real secrets on Cloudflare and
# never reads this file. Copy to .dev.vars to set them by hand; .dev.vars is
# gitignored.

# Required by /api/auth/register. Without it, anyone who finds your Worker URL
# can create an account on it.
REGISTRATION_TOKEN="token-dev-local"

# HMAC key used to fabricate KDF parameters for addresses that do not exist, so
# nobody can probe which emails are registered. Any random string works.
EMAIL_PROBE_SECRET="replace-with-a-random-string"
