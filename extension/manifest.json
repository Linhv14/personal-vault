{
  "manifest_version": 3,
  "name": "1pw",
  "version": "0.2.0",
  "description": "End-to-end encrypted personal vault: passwords, self-refreshing 2FA codes, and temporary share links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "activeTab", "offscreen", "clipboardWrite", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "1pw",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  }
}
