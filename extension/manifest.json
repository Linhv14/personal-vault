{
  "manifest_version": 3,
  "name": "Personal Vault",
  "version": "0.2.0",
  "description": "End-to-end encrypted personal vault: passwords, self-refreshing 2FA codes, and temporary share links.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "activeTab", "offscreen", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Personal Vault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  }
}
